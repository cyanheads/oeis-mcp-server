{
  "manifest_version": "0.3",
  "name": "oeis-mcp-server",
  "version": "0.1.0",
  "description": "Identify integer sequences by terms, search the OEIS, read formulas, programs, b-files, cross-refs.",
  "author": { "name": "cyanheads" },
  "repository": { "type": "git", "url": "https://github.com/cyanheads/oeis-mcp-server" },
  "homepage": "https://github.com/cyanheads/oeis-mcp-server#readme",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "oeis",
    "integer-sequences",
    "sequence-identification",
    "mathematics",
    "number-theory",
    "combinatorics",
    "generating-functions"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "OEIS_QUEUE_MAX_WAIT_MS": "${user_config.oeis_queue_max_wait_ms}"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "oeis_queue_max_wait_ms": {
      "type": "number",
      "title": "Queue wait budget (ms)",
      "description": "Longest a call waits in the oeis.org request queue (paced to one request every 10 seconds) before failing with a retry-after. Default 30000.",
      "required": false,
      "default": 30000,
      "min": 0
    }
  }
}
